# Lobby + world map for play.finsonly.net.
# Append to /mnt/user/appdata/stack/caddy/Caddyfile (the file the caddy container loads),
# swap in the map password hash, then: docker exec caddy caddy reload --config /etc/caddy/Caddyfile
# Same US-only geoblock, CrowdSec and access log as the jellyfin block. The lobby needs
# no login; /map asks for user "family" + the family password.

play.finsonly.net {
	@notUS not maxmind_geolocation {
		db_path /geoip/GeoLite2-Country.mmdb
		allow_countries US
	}

	encode zstd gzip
	header {
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	@map path /map /map/*
	basic_auth @map {
		family PASTE_HASH_HERE
	}

	# Inside route, handlers run in the order written: geoblock, then CrowdSec, then the lobby.
	route {
		respond @notUS 403
		crowdsec
		reverse_proxy arcade-lobby:8080
	}

	log {
		output file /var/log/caddy/access.log
		format json
	}
}
