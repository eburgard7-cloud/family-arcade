# Copy to /mnt/user/appdata/arcade/.env and fill in. Read by the scripts in scripts/.
# Keep this file private: anyone with a webhook URL can post to that channel.

# Discord webhook for the private #mod-alerts channel (only you can see it).
# Chat Guard flags and "server stopped" alerts go here. Leave empty to skip Discord.
DISCORD_WEBHOOK_MOD=

# Discord webhook for the adults' #announcements channel.
# arcade-open / arcade-close post "game room open / closed" here. Leave empty to skip.
DISCORD_WEBHOOK_GAMENIGHT=

# Name of the voice channel people should join on game night (used in the announcement).
DISCORD_VOICE_CHANNEL=game-night

# Also send alerts through Unraid's own notifications (phone, email, etc. via
# Settings > Notification Settings). 1 = yes, 0 = no.
UNRAID_NOTIFY=1
